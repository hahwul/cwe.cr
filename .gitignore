/lib/
/bin/
/.shards/
*.dwarf

# Hwaro build output (built by CI; source lives in docs/)
/docs/public/

# MITRE's XML catalog, the data build script's only input (see README).
# Not committed because of its size; download it to rebuild the data.
/data/cwec_v*.xml
/data/cwec_v*.xml.zip
/data/*.csv.zip

# Libraries don't need dependency lock
# Dependencies will be locked in applications that use them
/shard.lock
